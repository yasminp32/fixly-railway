# Copy to .env and adjust for your machine
DATABASE_URL=postgresql://postgres:4921@localhost:5432/mobileshopdb
SECRET_KEY=change-me-please
DEBUG=true
ASSIGN_RADIUS_KM=25
GEO_COUNTRY=IN
ALLOWED_HOSTS=127.0.0.1,localhost,localhost,.ngrok-free.dev,.loclx.io,

# Email
# On Render Free, SMTP ports are blocked; use an email API (SendGrid recommended).
SENDGRID_API_KEY=
DEFAULT_FROM_EMAIL=verified-sender@yourdomain.com

# Optional (SMTP fallback, e.g. local dev)
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
FRONTEND_RESET_URL=http://localhost:8000/reset-password

# Celery (required for async emails like shop-created notifications)
# Example (local): redis://localhost:6379/0
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=